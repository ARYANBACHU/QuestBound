# App (public, safe in the client bundle). Copy to .env
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 1 = run entirely on /fixtures (no backend). 0 = real Supabase.
EXPO_PUBLIC_USE_MOCKS=1

# Server secrets — NEVER put these in .env for the app. Set with:
#   npx supabase secrets set LLM_API_KEY=... SERPAPI_KEY=... LLM_BASE_URL=https://api.meta.ai/v1 LLM_MODEL=muse-spark-1.1 IMAGE_MODEL=muse-image-1.0 DEMO_FORCE_PASS=0
