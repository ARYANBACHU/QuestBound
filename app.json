{
  "expo": {
    "name": "Questbound",
    "slug": "questbound",
    "owner": "hacktx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "questbound",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hacktx.questbound"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B2E9A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hacktx.questbound"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Questbound",
      "shortName": "Questbound",
      "description": "A fairy-tale coloring book your fellowship fills in by living it.",
      "themeColor": "#4B2E9A",
      "backgroundColor": "#F5E6EA"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5E6EA",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Questbound uses your camera to capture mission proofs and scan fellowship invites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Questbound uses your photos as mission proofs.",
          "cameraPermission": "Questbound uses your camera to capture mission proofs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Questbound finds real places near your fellowship for your story."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ff35324e-0d1e-4e9a-a353-5a9cc0f9a591"
      }
    }
  }
}
